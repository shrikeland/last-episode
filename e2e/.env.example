# E2E environment — copy to .env and fill in values
# .env is gitignored and never committed.

# ── Target URL ───────────────────────────────────────────────────────────────
BASE_URL=https://www.episode.watch

# ── Test users ────────────────────────────────────────────────────────────────
# Real, confirmed accounts on the target site (create once, never delete).
# CI and local runs use different pairs — never share an account between them.
# Main user: owns the seeded library, almost every spec runs as this user
TEST_USER_EMAIL=your@email.com
TEST_USER_PASSWORD=yourpassword
# Second user ("friend"): social scenarios (friend requests, friend's profile) — `friendPage` fixture
TEST_USER2_EMAIL=your-friend@email.com
TEST_USER2_PASSWORD=yourpassword2

# ── Vercel bypass (optional, for CI) ─────────────────────────────────────────
# Get from Vercel → Project → Settings → Deployment Protection → Automation Bypass
# VERCEL_BYPASS_SECRET=

# ── Browser ───────────────────────────────────────────────────────────────────
HEADLESS=true
